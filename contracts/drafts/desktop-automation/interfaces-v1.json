                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "click",
                      "doubleClick"
                    ]
                  },
                  "elementId": {
                    "type": "string",
                    "pattern": "^\\d{1,4}$"
                  }
                },
                "required": [
                  "kind",
                  "elementId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "click",
                      "doubleClick"
                    ]
                  },
                  "point": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 20000
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 20000
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "kind",
                  "point"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "input"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  }
                },
                "required": [
                  "kind",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "key"
                  },
                  "key": {
                    "type": "string",
                    "enum": [
                      "a",
                      "s",
                      "c",
                      "v",
                      "x",
                      "z",
                      "f",
                      "Return",
                      "Tab",
                      "Escape",
                      "Backspace",
                      "Space",
                      "Left",
                      "Right",
                      "Down",
                      "Up",
                      "Home",
                      "End"
                    ]
                  },
                  "modifiers": {
                    "default": [],
                    "maxItems": 4,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "command",
                        "shift",
                        "option",
                        "control"
                      ]
                    }
                  }
                },
                "required": [
                  "kind",
                  "key",
                  "modifiers"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "scroll"
                  },
                  "point": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 20000
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 20000
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  "deltaX": {
                    "type": "integer",
                    "minimum": -1000,
                    "maximum": 1000
                  },
                  "deltaY": {
                    "type": "integer",
                    "minimum": -1000,
                    "maximum": 1000
                  }
                },
                "required": [
                  "kind",
                  "point",
                  "deltaX",
                  "deltaY"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "drag"
                  },
                  "from": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 20000
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 20000
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  "to": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 20000
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 20000
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "kind",
                  "from",
                  "to"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "operation",
          "observationId",
          "effectKey",
          "command"
        ],
        "additionalProperties": false
      }
    ]
  },
