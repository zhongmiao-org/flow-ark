{
  "version": 1,
  "status": "draft-unreleased",
  "tools": [
    {
      "name": "flowark_authoring_revise",
      "description": "For a local repair of existing scripts, prefer this over resending the entire plan. Change only summary and selected script purposes. Host preserves all structure, resource/action/schema fields and unaffected source hashes. Requires exact public and draft revisions; creates a private plan for user review, never codes or runs.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "revision",
          "draftId",
          "draftRevision",
          "changes"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "draftId": {
            "type": "string",
            "format": "uuid"
          },
          "draftRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "changes": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "updates": {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "entryId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,80}$"
                    },
                    "nodeId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,80}$"
                    },
                    "purpose": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "entryId",
                    "nodeId",
                    "purpose"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "summary",
              "updates"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "name": "flowark_authoring_plan",
      "description": "Validate and save a private workflow plan before coding. Node steps use installed project node schemas; script steps declare purpose/language/input but no code. Resources/actions are typed and deny by default. Returns draftId/draftRevision. No public files or actions are executed.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "revision",
          "plan"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "revision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "previousDraftId": {
            "type": "string",
            "format": "uuid"
          },
          "plan": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "constants": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "defaults": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "configurationSchema": {
                "default": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                },
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "stateSchema": {
                "default": {
                  "type": "object",
                  "properties": {},
                  "additionalProperties": false
                },
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "resources": {
                "default": [],
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,80}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "file",
                        "directory",
                        "browser",
                        "ai",
                        "skill",
                        "conversation-source",
                        "run-result"
                      ]
                    },
                    "access": {
                      "type": "string",
                      "enum": [
                        "read",
                        "write",
                        "readwrite",
                        "use"
                      ]
                    },
                    "required": {
                      "default": true,
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "kind",
                    "access"
                  ],
                  "additionalProperties": false
                }
              },
              "actions": {
                "default": [],
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,80}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 4000
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "entries": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{1,80}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "parameters": {
                      "default": {},
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "inputSchema": {
                      "default": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": false
                      },
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "resultSchema": {
                      "default": {
                        "type": "object"
                      },
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "capabilities": {
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "maxLength": 100
                      }
                    },
                    "resourceIds": {
                      "default": [],
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,80}$"
                      }
                    },
                    "actionIds": {
                      "default": [],
                      "maxItems": 50,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9_-]{1,80}$"
                      }
                    },
                    "steps": {
                      "minItems": 1,
                      "maxItems": 200,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      }
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "capabilities",
                    "steps"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "summary",
              "entries"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "name": "flowark_authoring_get",
      "description": "Read a saved plan, exact draft revision and code readiness. Supply entryId and nodeId to read one stored script. No model or runtime calls.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "draftId"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "draftId": {
            "type": "string",
            "format": "uuid"
          },
          "entryId": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "flowark_authoring_code_patch",
      "description": "Repair an existing approved script with exact text edits. Read authoring_get source/sourceSha256 first. Requires exact draft revision and source hash, unique nonoverlapping oldText matches, replaces less than half the source, and preserves every other byte. Existing syntax/SDK checks run before staging. Never executes.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "draftId",
          "draftRevision",
          "entryId",
          "nodeId",
          "patch"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "draftId": {
            "type": "string",
            "format": "uuid"
          },
          "draftRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "entryId": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          },
          "patch": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "baseSourceSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "edits": {
                "minItems": 1,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "oldText": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192
                    },
                    "newText": {
                      "type": "string",
                      "maxLength": 8192
                    }
                  },
                  "required": [
                    "oldText",
                    "newText"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "baseSourceSha256",
              "edits"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "name": "flowark_authoring_code",
      "description": "Stage one complete default-exported JS/TS module for one planned script node at exact draft revision. Checks syntax, installed SDK types and default export function shape; does not execute. Invalid code returns precise diagnostics and leaves previous source intact. Reuse the returned draftRevision for the next node.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "draftId",
          "draftRevision",
          "entryId",
          "nodeId",
          "source"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "draftId": {
            "type": "string",
            "format": "uuid"
          },
          "draftRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "entryId": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 262144
          }
        }
      }
    },
    {
      "name": "flowark_authoring_assemble",
      "description": "Only after all planned scripts are ready: deterministically emit Mermaid, bindings, script paths, schemas and publicFiles, then compile and atomically update the original project revision. Never executes or grants actions. Conflicts preserve both source and private draft.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "draftId",
          "draftRevision"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "draftId": {
            "type": "string",
            "format": "uuid"
          },
          "draftRevision": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    {
      "name": "flowark_project_node_schema",
      "description": "Read source planning node schemas and source-specific recipes. Use this for authoring_plan. Script nodes declare purpose, never inline code. Conditional/loop children are planning nodes; the assembler emits Mermaid. Runtime node schema is a separate advanced tool.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "types"
        ],
        "properties": {
          "types": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 100
            }
          }
        }
      }
    },
    {
      "name": "flowark_project_context",
      "description": "Read public project text files and installed SDK in one bounded request. No model call, no code execution, no private bindings. Use this instead of reading every file separately.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "flowark_project_init",
      "description": "Create a new source project with Mermaid, bindings, schemas, constants/defaults and README. Destination must be new; never overwrites.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "destination",
          "id",
          "name"
        ],
        "properties": {
          "destination": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    {
      "name": "flowark_node_schema",
      "description": "Read the actual installed node schema. Select a node type before generating code; do not guess fields.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "maxLength": 100
          }
        }
      }
    },
    {
      "name": "flowark_project_help",
      "description": "Read installed project format, configuration rules and available actions before writing a project.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "name": "flowark_project_open",
      "description": "Read declared files, revisions and entries of a local project. Does not execute scripts.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "flowark_project_read",
      "description": "Read one declared public file from a fixed project revision.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "path",
          "revision"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "flowark_project_validate",
      "description": "Compile Mermaid bindings, scripts, schemas and complete package without executing project scripts. Returns exact diagnostics.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "flowark_project_configuration",
      "description": "Resolve and validate configuration layers. Selecting a profile explicitly enables that project root env. Never reads system env.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "profile": {
            "type": "string"
          },
          "instance": {
            "type": "object"
          },
          "overrides": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "flowark_project_from_zip",
      "description": "Convert one exact standard ZIP into a new local source project. Never reads private instances or overwrites an existing directory.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "zip",
          "destination"
        ],
        "properties": {
          "zip": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "flowark_project_package",
      "description": "Build a fixed project revision and write a new complete ZIP. Refuses existing output files. Does not run the workflow.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "destination",
          "revision"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "flowark_project_write",
      "description": "Apply a checked batch of public source changes at the exact revision. Conflicts never overwrite external edits; incomplete writes block compilation until recovery.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "revision",
          "changes"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "content"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    {
      "name": "flowark_runtime_configure",
      "description": "Propose instance configuration, input values and resource/grant bindings. Exact instance revision required. Native user review is mandatory; protected resources remain host-validated. Only instance values persist. Use profile/overrides/input on preview/run for a single immutable development snapshot.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "revision"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "configuration": {
            "type": "object"
          },
          "resources": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "browserId": {
                  "type": "string"
                },
                "provider": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "skill": {
                  "type": "object"
                },
                "source": {
                  "type": "object"
                },
                "result": {
                  "type": "object"
                }
              }
            }
          },
          "grants": {
            "type": "object",
            "additionalProperties": {
              "enum": [
                "deny",
                "confirm",
                "auto"
              ]
            }
          },
          "inputs": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "flowark_runtime_history",
      "description": "List the latest 100 run identities belonging to this paired project, without executing or replaying anything.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "flowark_runtime_prepare",
      "description": "Build the fixed revision and create or reuse a desktop debugging instance; never starts a run.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "revision"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "isolate": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "name": "flowark_runtime_instance",
      "description": "Read this paired project debugging instance only.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "flowark_runtime_preview",
      "description": "Read the exact normal runtime review. Does not execute.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "entryId"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "entryId": {
            "type": "string"
          },
          "debug": {
            "type": "boolean"
          },
          "profile": {
            "type": "string"
          },
          "overrides": {
            "type": "object"
          },
          "input": {
            "type": "object"
          }
        }
      }
    },
    {
      "name": "flowark_runtime_run",
      "description": "Request execution through the normal host. The user must approve the desktop review dialog; tool calls cannot self-approve.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "entryId",
          "requestId"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "entryId": {
            "type": "string"
          },
          "debug": {
            "type": "boolean"
          },
          "profile": {
            "type": "string"
          },
          "overrides": {
            "type": "object"
          },
          "input": {
            "type": "object"
          },
          "requestId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9-]{36}$"
          }
        }
      }
    },
    {
      "name": "flowark_runtime_status",
      "description": "Read an existing run owned by this project.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "runId"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "flowark_runtime_control",
      "description": "Pause, resume, step or cancel an owned run. Never creates a replacement run.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "runId",
          "action"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "runId": {
            "type": "string"
          },
          "action": {
            "enum": [
              "pause",
              "resume",
              "step",
              "cancel"
            ]
          }
        }
      }
    }
  ]
}
