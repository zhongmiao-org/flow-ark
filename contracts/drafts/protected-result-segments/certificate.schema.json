{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flowark.local/contracts/drafts/protected-result-segments/certificate.schema.json",
  "type": "object",
  "properties": {
    "version": { "const": 1 },
    "policy": { "const": "finite-json-output-v1" },
    "schemaSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonicalBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
    "valueNodes": { "type": "integer", "minimum": 1, "maximum": 262144 },
    "depth": { "type": "integer", "minimum": 0, "maximum": 64 },
    "workBytes": { "type": "integer", "minimum": 1, "maximum": 134217728 }
  },
  "required": [
    "version",
    "policy",
    "schemaSha256",
    "canonicalBytes",
    "valueNodes",
    "depth",
    "workBytes"
  ],
  "additionalProperties": false
}
