{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flowark.local/contracts/drafts/result-retention/wire.schema.json",
  "$ref": "#/$defs/RetentionSet",
  "$defs": {
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Cell": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "json"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "kind",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "bytes"
            },
            "data": {
              "type": "string",
              "minLength": 4,
              "maxLength": 5464,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "required": [
            "kind",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "body": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "kind",
            "body"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "concat"
            },
            "parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "required": [
            "kind",
            "parts"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "list"
            },
            "parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "required": [
            "kind",
            "parts"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "array"
            },
            "parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "required": [
            "kind",
            "parts"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "object"
            },
            "parts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "required": [
            "kind",
            "parts"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "members"
            },
            "entries": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "value": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "key",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind",
            "entries"
          ],
          "additionalProperties": false
        }
      ]
    },
    "CellRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "cell": {
          "$ref": "#/$defs/Cell"
        }
      },
      "required": [
        "id",
        "cell"
      ],
      "additionalProperties": false
    },
    "ValueRoot": {
      "type": "object",
      "properties": {
        "resultId": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "root": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8388608
        }
      },
      "required": [
        "resultId",
        "root",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false
    },
    "RetentionSet": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[^\\uD800-\\uDFFF]+$"
        },
        "roots": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/ValueRoot"
          }
        },
        "cells": {
          "type": "array",
          "maxItems": 16384,
          "items": {
            "$ref": "#/$defs/CellRecord"
          }
        }
      },
      "required": [
        "version",
        "runId",
        "roots",
        "cells"
      ],
      "additionalProperties": false
    }
  }
}
